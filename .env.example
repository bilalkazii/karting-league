# Karting - Supabase environment
#
# Copy this file to `.env.local` and fill in your own project values.
# `.env.local` is gitignored. NEVER commit real keys or a real `.env*` file.
#
# The app runs with NO configuration at all: every repository falls back to the
# mock dataset in `src/lib/mock-data.ts` when these are unset.
#
# Create a project at https://supabase.com and copy the URL and the public
# (anon) key from Project Settings > API.

# Public PostgREST endpoint for your project, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public (anon) publishable key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER-SIDE ONLY - it bypasses Row Level Security entirely.
# Must NOT be prefixed with NEXT_PUBLIC_ (Next.js would inline it into the
# client bundle) and must never be committed. Only src/lib/supabase/admin.ts
# reads it. Optional - only needed for server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=
